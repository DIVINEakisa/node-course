<!DOCTYPE html>
<html lang="en">
   <%- include('./partial/head.ejs') %>
  <body>
    <%- include('./partial/navbar.ejs') %>
    <div class="blogs content">
      <h2>All Blogs</h2>
<% if (blogs.length > 0) { %>
  <% blogs.forEach(blog => { %>

    <a href="/blogs/<%= blog._id %>">
      <h3><%= blog.title %></h3>
    </a>
    <p><%= blog.snippet %></p>

  <% }) %>
<% } %>
    </div>
  <%- include('./partial/footer.ejs') %>
  </body>
</html>
